# ─── 클라우드 서버 환경변수 ───────────────────────────────────
# 이 값들을 배포 플랫폼의 환경변수 또는 server/.env 에 설정한다.

# 단일 접근 토큰 (필수). 미설정 시 서버가 부팅을 거부한다.
# 로컬 dev 에서도 임의 값이라도 반드시 설정해야 한다.
AUTH_TOKEN=test

# Postgres 접속 문자열 (필수). 미설정 시 서버가 부팅을 거부한다.
# 스키마 적용은 서버가 아니라 배포 단계의 `npm run db:deploy` 책임이다
# (인스턴스가 여럿이면 부팅 시 DDL 이 경합한다).
#
# Supabase 처럼 pooler 를 쓰면 두 개가 필요하다:
#  - DATABASE_URL : 런타임용 트랜잭션 모드 pooler(6543) + `pgbouncer=true`
#  - DIRECT_URL   : 마이그레이션용 세션 모드 pooler(5432).
#    트랜잭션 모드는 prepared statement 를 못 써서 migrate 가 실패한다.
# pooler 가 없는 일반 Postgres 라면 둘 다 같은 값을 넣으면 된다.
DATABASE_URL="postgresql://user:password@host:6543/dbname?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/dbname"

# 로컬 파일 기반 실시간 세션 뷰(/api/sessions*)가 읽는 디렉토리.
# 미설정 시 ~/.claude/projects. 클라우드에는 이 경로가 없으므로 해당 뷰는 비게 된다.
CLAUDE_DATA_DIR=/data/projects

# 리슨 포트 / 호스트. 미설정 시 3001 / 0.0.0.0.
# 로컬 dev 를 localhost 전용으로 되돌리려면 HOST=127.0.0.1.
PORT=3001
HOST=0.0.0.0

# CORS 허용 오리진. 미설정 시 '*'(토큰 인증이 1차 방어선).
# 프론트엔드 도메인으로 좁히려면 여기에 지정.
ALLOWED_ORIGIN=*
