# ─── 로컬 동기화 잡 설정 ───────────────────────────────────────
# 이 파일을 sync/.env 로 복사해 채우거나, `npm run setup` 으로 대화형 생성한다.
# (process.env 가 있으면 그쪽이 우선. 값 우선순위: process.env > sync/.env)

# 클라우드 Observer 서버 주소 (끝 슬래시 없이). 필수.
CLOUD_URL=https://observer.example.com

# 서버와 공유하는 단일 접근 토큰 (서버의 AUTH_TOKEN 과 동일해야 함). 필수.
AUTH_TOKEN=

# 세션 요약에 쓸 모델 = `claude --model` 값 (선택, 기본값 haiku).
# 요약은 로컬에 로그인된 `claude` CLI(구독 인증)로 생성하므로 API 키가 필요 없다.
OBSERVER_SUMMARY_MODEL=haiku
